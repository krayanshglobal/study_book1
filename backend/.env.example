MONGO_URL=mongodb://localhost:27017
DB_NAME=cmaths
JWT_SECRET=replace-with-a-long-random-secret
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Mobile OTP delivery. Supported providers: fast2sms, msg91, 2factor.
OTP_PROVIDER=fast2sms
OTP_PROVIDER_API_KEY=
OTP_PROVIDER_TEMPLATE_ID=

# Provider-specific keys may be used instead of OTP_PROVIDER_API_KEY:
# FAST2SMS_API_KEY=
# MSG91_AUTH_KEY=
# TWO_FACTOR_API_KEY=

# Local testing only. Never enable this in production; it returns the OTP in
# the API response and writes it to backend logs.
OTP_DEV_MODE=false
